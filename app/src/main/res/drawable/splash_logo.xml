<layer-list xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- the app icon on its Sunset disc. Android draws a splash icon 1.8 times larger and shows only a 192 dp
         circle of it, so this keeps the whole disc in view, about 187 dp wide -->
    <item
        android:width="104dp"
        android:height="104dp"
        android:drawable="@drawable/ic_app_logo"
        android:gravity="center"
        tools:ignore="UnusedAttribute" />
</layer-list>